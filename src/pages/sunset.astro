---
import Base from '../layouts/Base.astro';
const title = 'Catch Your Sunset | Suncoast Home Check';
const description = "A little reminder from Suncoast Home Check — don't forget to catch your sunset.";
---
<Base title={title} description={description} canonical="/sunset/">
  <section class="sunset-stage">
    <img class="sunset-img" src="/assets/sunset.jpg" alt="A Florida Gulf Coast beach at golden-hour sunset" />
    <div class="sun-glow"></div>
    <div class="water-sheen"></div>
    <div class="surf">
      <div class="wash wash-1"></div>
      <div class="wash wash-2"></div>
      <div class="wash wash-3"></div>
      <div class="wash wash-4"></div>
    </div>
    <div class="sunset-copy">
      <p class="sunset-tag">Don't forget to catch your sunset.</p>
      <span class="sunset-by">Bryan Alan Manly</span>
      <a class="btn btn-gold" href="/">Back to Home</a>
    </div>
  </section>
</Base>

<style>
  .sunset-stage {
    position: relative; height: 88vh; min-height: 560px; overflow: hidden;
    display: flex; align-items: flex-end; justify-content: center;
  }
  .sunset-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sun-glow {
    position: absolute; left: 36%; top: 50%; width: 36%; height: 26%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(255,210,130,0.5), rgba(255,210,130,0) 70%);
    mix-blend-mode: screen; animation: sunPulse 6.5s ease-in-out infinite; pointer-events: none;
  }
  /* light glinting across the water on the right */
  .water-sheen {
    position: absolute; right: 0; bottom: 4%; width: 40%; height: 34%;
    background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.22) 50%, rgba(255,255,255,0) 100%);
    filter: blur(8px); animation: sheen 8s linear infinite; pointer-events: none;
  }
  /* waves washing up the shore — broad, spanning the foreground */
  .surf { position: absolute; right: 0; width: 40%; bottom: 0; height: 52%; overflow: hidden; pointer-events: none; }
  .wash {
    position: absolute; left: -10%; width: 120%; height: 40px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255,255,255,0.62), rgba(255,255,255,0) 74%);
    filter: blur(5px); opacity: 0;
  }
  .wash-1 { bottom: 4%;  animation: wash 5.5s ease-in-out infinite; }
  .wash-2 { bottom: 15%; animation: wash 5.5s ease-in-out infinite 1.6s; }
  .wash-3 { bottom: 27%; animation: wash 6s ease-in-out infinite 3.1s; }
  .wash-4 { bottom: 38%; animation: wash 6.4s ease-in-out infinite 4.4s; }
  @keyframes sunPulse { 0%,100% { opacity: .45 } 50% { opacity: .8 } }
  @keyframes sheen { 0% { transform: translateX(-45%) } 100% { transform: translateX(130%) } }
  @keyframes wash {
    0%   { opacity: 0;   transform: translateY(42px) scaleX(.92); }
    42%  { opacity: .72; }
    62%  { opacity: .55; }
    100% { opacity: 0;   transform: translateY(-30px) scaleX(1.06); }
  }
  .sunset-copy { position: relative; z-index: 3; text-align: center; padding: 0 24px 9vh; }
  .sunset-tag {
    font-family: "Cormorant Garamond", Georgia, serif; font-weight: 600;
    font-size: clamp(30px, 5vw, 58px); line-height: 1.1; color: #fff;
    text-shadow: 0 3px 22px rgba(0,0,0,.5); margin: 0;
  }
  .sunset-by {
    display: block; color: #f4ecdd; font-size: 14px; letter-spacing: .16em;
    text-transform: uppercase; margin: 14px 0 26px; text-shadow: 0 2px 10px rgba(0,0,0,.5);
  }
  .sunset-copy .btn { box-shadow: 0 10px 30px rgba(0,0,0,.35); }
  @media (prefers-reduced-motion: reduce) { .sun-glow, .water-sheen, .wash { animation: none; } }
  @media (max-width: 700px) { .sunset-stage { height: 82vh; } }
</style>
