---
import Base from '../layouts/Base.astro';
const title = 'Catch Your Sunset | Suncoast Home Check';
const description = "A little reminder from Suncoast Home Check — don't forget to catch your sunset.";
---
<Base title={title} description={description} canonical="/sunset/">
  <section class="sunset-stage">
    <img class="sunset-img" src="/assets/sunset.jpg" alt="A Florida Gulf Coast beach at golden-hour sunset" />
    <div class="sun-glow"></div>
    <div class="water-sheen"></div>
    <div class="foam foam-1"></div>
    <div class="foam foam-2"></div>
    <div class="foam foam-3"></div>
    <div class="sunset-copy">
      <p class="sunset-tag">Don't forget to catch your sunset.</p>
      <span class="sunset-by">Bryan Alan Manly</span>
      <a class="btn btn-gold" href="/">Back to Home</a>
    </div>
  </section>
</Base>

<style>
  .sunset-stage {
    position: relative;
    height: 88vh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .sunset-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* soft glow that gently breathes over the sun's reflection */
  .sun-glow {
    position: absolute; left: 36%; top: 50%; width: 36%; height: 26%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(255,210,130,0.55), rgba(255,210,130,0) 70%);
    mix-blend-mode: screen; animation: sunPulse 6.5s ease-in-out infinite; pointer-events: none;
  }
  /* light glinting across the water */
  .water-sheen {
    position: absolute; left: -35%; bottom: 6%; width: 60%; height: 42%;
    background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0) 100%);
    filter: blur(7px); animation: sheen 10s linear infinite; pointer-events: none;
  }
  /* gentle foam washing up the shore */
  .foam {
    position: absolute; height: 12px; border-radius: 50%;
    background: rgba(255,255,255,0.38); filter: blur(8px); opacity: 0; pointer-events: none;
  }
  .foam-1 { left: 42%; bottom: 19%; width: 36%; animation: wash 7.5s ease-in-out infinite; }
  .foam-2 { left: 50%; bottom: 11%; width: 42%; animation: wash 7.5s ease-in-out infinite 2.5s; }
  .foam-3 { left: 36%; bottom: 26%; width: 28%; animation: wash 7.5s ease-in-out infinite 5s; }
  @keyframes sunPulse { 0%,100% { opacity: .5 } 50% { opacity: .85 } }
  @keyframes sheen { 0% { transform: translateX(0) } 100% { transform: translateX(250%) } }
  @keyframes wash {
    0% { opacity: 0; transform: translateY(16px) scaleX(.9) }
    45% { opacity: .6 } 62% { opacity: .5 }
    100% { opacity: 0; transform: translateY(-12px) scaleX(1.06) }
  }
  .sunset-copy { position: relative; z-index: 3; text-align: center; padding: 0 24px 9vh; }
  .sunset-tag {
    font-family: "Cormorant Garamond", Georgia, serif; font-weight: 600;
    font-size: clamp(30px, 5vw, 58px); line-height: 1.1; color: #fff;
    text-shadow: 0 3px 22px rgba(0,0,0,.5); margin: 0;
  }
  .sunset-by {
    display: block; color: #f4ecdd; font-size: 14px; letter-spacing: .16em;
    text-transform: uppercase; margin: 14px 0 26px; text-shadow: 0 2px 10px rgba(0,0,0,.5);
  }
  .sunset-copy .btn { box-shadow: 0 10px 30px rgba(0,0,0,.35); }
  @media (prefers-reduced-motion: reduce) {
    .sun-glow, .water-sheen, .foam { animation: none; }
    .foam { opacity: .28; }
  }
  @media (max-width: 700px) { .sunset-stage { height: 82vh; } }
</style>
