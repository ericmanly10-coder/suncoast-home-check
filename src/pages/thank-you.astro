---
import Base from '../layouts/Base.astro';
const title = 'Thank You | Suncoast Home Check — Tampa Bay Home Watch';
const description =
  'Thank you for reaching out to Suncoast Home Check. Bryan Alan Manly will review your details and follow up with a free home-watch quote for your Tampa Bay home, townhome, or condo.';
---
<Base title={title} description={description} canonical="/thank-you/">
  <section class="page-hero">
    <img src="/assets/hero.jpg" alt="Calm Florida Gulf-coast home at golden hour" />
    <div class="scrim"></div>
    <div class="inner">
      <p class="eyebrow">Request Received</p>
      <h1>Thank you — we'll be in touch.</h1>
      <div class="gold-line"></div>
      <p class="intro">Bryan will review your details and follow up shortly with a simple plan and a free quote for your home.</p>
    </div>
  </section>

  <div class="inline-cta">
    <h2>Need something sooner?</h2>
    <a class="btn btn-gold" href="tel:17276412419">Call 727-641-2419</a>
    <a class="btn btn-navy" href="/">Back to Home</a>
  </div>
</Base>
